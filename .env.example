# Copiar a .env.local (Git lo ignora) y reemplazar <contrasena>. Nunca versionar valores reales.
# Archivos .env* quedan excluidos por .gitignore, salvo este ejemplo.

# Base de desarrollo de la aplicacion (usada por Next y por drizzle-kit).
DATABASE_URL=postgresql://angel_tears:<contrasena>@localhost:5432/angel_tears_dev

# Base aislada para pruebas de integracion. Debe ser local, terminar en _test y ser distinta de
# DATABASE_URL: las pruebas crean y borran tablas. El arnes se niega a usar otra base.
DATABASE_URL_TEST=postgresql://angel_tears:<contrasena>@localhost:5432/angel_tears_test

# Better Auth. Secreto con el que se firman cookies y tokens: largo y aleatorio, distinto en cada
# entorno y nunca versionado. Generar uno con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=<secreto-largo-y-aleatorio>
# URL publica de la aplicacion; en desarrollo, la de `pnpm dev`. Los enlaces de los correos de
# recuperacion se arman con esta URL, no con datos de la solicitud.
BETTER_AUTH_URL=http://localhost:3000

# Resend: SOLO para el correo de recuperacion de contrasena. Sin estas dos variables la
# aplicacion funciona pero no puede enviar correos (la recuperacion responde igual, sin enviar).
# Para probar a mano sin dominio propio: crear una cuenta en Resend, generar una clave de API y
# usar el remitente de pruebas de Resend; ese remitente solo entrega al correo con el que se
# registro la cuenta de Resend, asi que la cuenta de la Administradora debe usar ese correo.
# En produccion hace falta un dominio remitente verificado en Resend (pendiente del hosting).
# Los tests y los E2E nunca usan Resend: reemplazan el proveedor y no envian nada.
RESEND_API_KEY=<clave-de-api-de-resend>
RESEND_FROM=Angel Tears <onboarding@resend.dev>
