# Copiar a .env.demo.local. No se carga .env.local en los comandos demo.
# Solo conexion DIRECTA del proyecto angel-tears-demo confirmado por el responsable.
DEMO_DATABASE_URL_DIRECT=
# Independiente del secreto comercial. Nunca se imprime ni se pasa por argumentos.
DEMO_BETTER_AUTH_SECRET=
DEMO_BETTER_AUTH_URL=
# Opcional: contraseña ficticia en archivo privado para aprovisionamiento automatizado.
# Vacio mantiene la solicitud oculta en terminal. Nunca se copia a Vercel.
DEMO_ADMIN_CONTRASENA=
# JSON local con referencias de imagenes autorizadas ya subidas a Cloudinary demo.
DEMO_IMAGENES_ARCHIVO=
DEMO_CLOUDINARY_CLOUD_NAME=
